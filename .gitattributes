* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore

# GitHub Linguist: Keep repository language breakdown clean (Blade & PHP only)
*.blade.php linguist-language=Blade
*.php linguist-language=PHP

# Exclude deployment, configuration, and script wrappers from language statistics
Dockerfile linguist-detectable=false
docker-entrypoint.sh linguist-detectable=false
*.js linguist-detectable=false
*.css linguist-detectable=false
*.html linguist-detectable=false
public/**/*.html linguist-detectable=false
